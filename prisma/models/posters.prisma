model CommunityPoster {
  id        Int      @id @default(autoincrement())
  slot      Int      @unique
  slug      String   @default("")
  title     String   @default("")
  enabled   Boolean  @default(false)
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("community_posters")
}

model CommunityPosterState {
  id        Int      @id @default(1)
  version   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("community_poster_state")
}
