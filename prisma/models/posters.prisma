model CommunityPoster {
  id        Int      @id @default(autoincrement())
  guildId   String
  slot      Int
  slug      String   @default("")
  title     String   @default("")
  /** Filename under station/posters/ (e.g. FRAME_COBALT.jpg). Official names preferred. */
  imageFile String  @default("")
  /** VRChat group id (grp_…) for Open Group on the board. Empty = none. */
  groupId   String  @default("")
  enabled   Boolean @default(false)
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, slot])
  @@index([guildId])
  @@map("community_posters")
}

model CommunityPosterState {
  id        Int      @id @default(autoincrement())
  guildId   String   @unique
  version   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@index([guildId])
  @@map("community_poster_state")
}
