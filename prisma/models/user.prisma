model User {
  id                     Int                      @id @default(autoincrement())
  discordId              String                   @unique
  activeAttendanceEvent  ActiveAttendanceEvent?   @relation("UserActiveAttendanceEvent")
  cohostAttendanceEvents AttendanceEvent[]        @relation("CohostAttendanceEvent")
  hostAttendanceEvents   AttendanceEvent[]        @relation("HostAttendanceEvent")
  attendanceStaff        AttendanceStaff[]
  squadMemberships       SquadMember[]
  vrchatAccounts         VRChatAccount[]
  whitelistEntries        WhitelistEntry[]
  voicePatrolTimes               VoicePatrolTime[]
  voicePatrolMonthly             VoicePatrolMonthlyTime[]
  voicePatrolPromotionNotifications VoicePatrolPromotionNotification[]
  voicePatrolRoleObtainedAt         VoicePatrolRoleObtainedAt[]
  voicePatrolPromotionBlocks        VoicePatrolPromotionBlock[]
  activeVoicePatrolSessions         ActiveVoicePatrolSession[]
  userPreferences                   UserPreferences?
  leaveOfAbsences        LeaveOfAbsence[]
  roleAssignmentTracking RoleAssignmentTracking[]
  roleTrackingWarnings   RoleTrackingWarning[]
}

model VRChatAccount {
  id                        Int               @id @default(autoincrement())
  userId                    Int
  vrcUserId                 String
  accountType               VRChatAccountType @default(IN_VERIFICATION)
  verificationCode          String?
  verificationGuildId       String? // Guild ID where verification was initiated
  vrchatUsername            String? // Cached VRChat username
  usernameUpdatedAt         DateTime? // Last time username was updated
  phantomCompilerReason     String?           @db.Text // Self-reported phantom/sensory needs (MAIN account only)
  phantomCompilerEnrolledAt DateTime?
  user                      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "VRChatAccount_userId_fkey")
  @@index([vrcUserId], map: "VRChatAccount_vrcUserId_idx")
}

/// Last VRChat profile seen for a friend, used to log real field changes.
model VRChatObservedProfile {
  vrcUserId         String   @id @db.VarChar(64)
  displayName       String?  @db.VarChar(191)
  username          String?  @db.VarChar(191)
  pronouns          String?  @db.VarChar(64)
  status            String?  @db.VarChar(32)
  statusDescription String?  @db.Text
  updatedAt         DateTime @updatedAt

  @@map("vrchat_observed_profiles")
}
